# Copy to .env and fill in the values. Never commit .env.

# data.go.kr service key (apply for: AirKorea air pollution info, GK2A satellite imagery)
DATA_GO_KR_SERVICE_KEY=

# NASA FIRMS fire hotspots — https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# Meta Model API (Muse Spark 1.3, SAM 3.1)
MODEL_API_KEY=

# Muse Spark Open host — fill only the provider that granted credits
BASETEN_API_KEY=
FIREWORKS_API_KEY=

# Comparison baseline (gpt-6-luna, capped at $5)
OPENAI_API_KEY=
